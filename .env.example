# Clé API Mistral (https://console.mistral.ai). Sans clé, l'analyse passe par les règles locales.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Rôle du nœud : central ou relais
NODE_MODE=central

# Base SQLite du journal (relatif à la racine du repo)
DB_PATH=data/events.db

# Zone de démo : centre et rayon de recherche des repères
ZONE_NAME=Paris centre
ZONE_LAT=48.8584
ZONE_LON=2.3470
ZONE_RADIUS_M=2000
