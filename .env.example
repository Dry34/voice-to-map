# Clé API Mistral (https://console.mistral.ai). Sans clé, l'analyse passe par les règles locales.
MISTRAL_API_KEY=
MISTRAL_MODEL=voxtral-small-2507   # 60 req/min sur notre clé ; ministral/small sont à 2 ou 0 req/min

# Rôle du nœud : central ou relais
NODE_MODE=central

# Base SQLite du journal (relatif à la racine du repo)
DB_PATH=data/events.db

# Zone de démo : centre et rayon de recherche des repères
ZONE_NAME=Paris centre
ZONE_LAT=48.8584
ZONE_LON=2.3470
ZONE_RADIUS_M=2000

# Transcription (push-to-talk)
STT_MODEL=voxtral-mini-latest
STT_LANGUAGE=fr   # fr transcrit bien le français ET l anglais ; vide = détection auto (moins bon)
